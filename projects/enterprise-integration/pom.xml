<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version><executions><execution><id>jdbc</id><phase>package</phase><goals><goal>copy</goal></goals><configuration><artifactItems><artifactItem><groupId>com.oracle.database.jdbc</groupId><artifactId>ojdbc11</artifactId><version>23.6.0.24.10</version><outputDirectory>${project.build.directory}/drivers</outputDirectory><destFileName>ojdbc11.jar</destFileName></artifactItem></artifactItems></configuration></execution></executions></plugin>
</plugins></build></project>
