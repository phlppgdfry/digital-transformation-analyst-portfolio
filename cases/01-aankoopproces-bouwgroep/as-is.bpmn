<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P2P_ASIS" targetNamespace="https://example.invalid/portfolio/p2p">
  <process id="Process_P2P_ASIS" name="AS-IS aankoopaanvraag (fictief)" isExecutable="false">
    <startEvent id="Start_Request" name="Nood op werf"/><task id="Task_Email" name="Mail of bel aankoop"/><task id="Task_Retype" name="Neem gegevens over in ERP / Excel"/><exclusiveGateway id="Gateway_Complete" name="Gegevens volledig?"/><task id="Task_Clarify" name="Vraag ontbrekende info op"/><task id="Task_Approve" name="Zoek goedkeuring via losse kanalen"/><exclusiveGateway id="Gateway_Approved" name="Goedgekeurd?"/><task id="Task_CreateOrder" name="Maak aankooporder in ERP"/><task id="Task_StatusCall" name="Aanvrager belt voor status"/><endEvent id="End_Order" name="Order geplaatst"/><endEvent id="End_Rejected" name="Niet geplaatst"/>
    <sequenceFlow id="f1" sourceRef="Start_Request" targetRef="Task_Email"/><sequenceFlow id="f2" sourceRef="Task_Email" targetRef="Task_Retype"/><sequenceFlow id="f3" sourceRef="Task_Retype" targetRef="Gateway_Complete"/><sequenceFlow id="f4" sourceRef="Gateway_Complete" targetRef="Task_Clarify" name="Nee"/><sequenceFlow id="f5" sourceRef="Task_Clarify" targetRef="Task_Retype"/><sequenceFlow id="f6" sourceRef="Gateway_Complete" targetRef="Task_Approve" name="Ja"/><sequenceFlow id="f7" sourceRef="Task_Approve" targetRef="Gateway_Approved"/><sequenceFlow id="f8" sourceRef="Gateway_Approved" targetRef="Task_CreateOrder" name="Ja"/><sequenceFlow id="f9" sourceRef="Task_CreateOrder" targetRef="End_Order"/><sequenceFlow id="f10" sourceRef="Gateway_Approved" targetRef="End_Rejected" name="Nee"/><sequenceFlow id="f11" sourceRef="Task_StatusCall" targetRef="Task_Approve" name="Opvolging"/>
  </process>
</definitions>
