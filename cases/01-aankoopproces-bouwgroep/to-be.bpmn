<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P2P_TOBE" targetNamespace="https://example.invalid/portfolio/p2p">
  <process id="Process_P2P_TOBE" name="TO-BE digitale aankoopaanvraag (fictief)" isExecutable="false">
    <startEvent id="Start_Request" name="Nood op werf"/><userTask id="Task_Form" name="Dien mobiele aanvraag in"/><serviceTask id="Task_Validate" name="Valideer verplichte velden en masterdata"/><exclusiveGateway id="Gateway_Valid" name="Aanvraag geldig?"/><userTask id="Task_Correct" name="Corrigeer aanvraag"/><userTask id="Task_Review" name="Beoordeel aanvraag en budget"/><exclusiveGateway id="Gateway_Approved" name="Goedgekeurd?"/><serviceTask id="Task_ERP" name="Maak ERP-aankooporder (idempotent)"/><exclusiveGateway id="Gateway_ERP" name="ERP verwerkt?"/><serviceTask id="Task_Retry" name="Plan retry / exception"/><serviceTask id="Task_Notify" name="Werk status en auditspoor bij"/><endEvent id="End_Order" name="Orderreferentie gedeeld"/><endEvent id="End_Rejected" name="Afwijzing met reden"/>
    <sequenceFlow id="f1" sourceRef="Start_Request" targetRef="Task_Form"/><sequenceFlow id="f2" sourceRef="Task_Form" targetRef="Task_Validate"/><sequenceFlow id="f3" sourceRef="Task_Validate" targetRef="Gateway_Valid"/><sequenceFlow id="f4" sourceRef="Gateway_Valid" targetRef="Task_Correct" name="Nee"/><sequenceFlow id="f5" sourceRef="Task_Correct" targetRef="Task_Validate"/><sequenceFlow id="f6" sourceRef="Gateway_Valid" targetRef="Task_Review" name="Ja"/><sequenceFlow id="f7" sourceRef="Task_Review" targetRef="Gateway_Approved"/><sequenceFlow id="f8" sourceRef="Gateway_Approved" targetRef="Task_ERP" name="Ja"/><sequenceFlow id="f9" sourceRef="Task_ERP" targetRef="Gateway_ERP"/><sequenceFlow id="f10" sourceRef="Gateway_ERP" targetRef="Task_Retry" name="Nee"/><sequenceFlow id="f11" sourceRef="Task_Retry" targetRef="Task_ERP" name="Veilige retry"/><sequenceFlow id="f12" sourceRef="Gateway_ERP" targetRef="Task_Notify" name="Ja"/><sequenceFlow id="f13" sourceRef="Task_Notify" targetRef="End_Order"/><sequenceFlow id="f14" sourceRef="Gateway_Approved" targetRef="Task_Notify" name="Nee"/><sequenceFlow id="f15" sourceRef="Task_Notify" targetRef="End_Rejected" name="Afgewezen"/>
  </process>
</definitions>
